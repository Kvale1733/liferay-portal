@default = "refresh"
definition {

	function pauseRefresh() {
		WaitForSPARefresh();

		selenium.pause(5000);

		selenium.refresh();

		WaitForLiferayEvent.initializeLiferayEventLog();

		

		
	}

	function refresh() {
		WaitForSPARefresh();

		selenium.refresh();

		WaitForLiferayEvent.initializeLiferayEventLog();

		

		
	}

	function refreshNoSPARefresh() {
		selenium.refresh();

		WaitForLiferayEvent.initializeLiferayEventLog();

		

		
	}

}