@default = "assertConsoleTextPresent"
definition {

	function assertConsoleTextPresent {
		WaitForSPARefresh();

		selenium.assertConsoleTextPresent();

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();
	}

	function assertConsoleTextPresentNoError {
		WaitForSPARefresh();

		selenium.assertConsoleTextPresent();
	}

}