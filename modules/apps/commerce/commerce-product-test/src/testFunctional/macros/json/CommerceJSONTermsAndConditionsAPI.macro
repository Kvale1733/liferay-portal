definition {

	macro _addTerm {
		Variables.assertDefined(parameterList = "${termName},${priority}");

		var baseURL = "${baseURL}";

		if (!(isSet(baseURL))) {
			var baseURL = PropsUtil.get("portal.url");
		}

		if (!(isSet(termDescription))) {
			var termDescription = "";
		}

		var curl = '''
			${baseURL}/o/headless-commerce-admin-order/v1.0/terms \
			-u test@liferay.com:test \
			-H 'accept: application/json' \
 			-H 'Content-Type: application/json' \
  			-d '{
  					"active": true,
			        "description": {
			          "en_US": "${termDescription}"
			        },
			        "externalReferenceCode": "",
			        "name": "${termName}",
			        "label": {
			          "en_US": "${termName}"
			        },
			        "priority": ${priority},
			        "type": "payment-terms"
				}'
			''';

		JSONCurlUtil.post("${curl}");
	}

}