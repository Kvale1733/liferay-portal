definition {

	macro viewContentPG {
		AssertTextMatches(
			locator1 = "Drools#DROOLS_CONTENT",
			value1 = ".*${welcomeMessage}.*");

		AssertTextMatches(
			locator1 = "Drools#DROOLS_CONTENT",
			value1 = ".*${droolsContent}.*");
	}

	macro viewDefaultPG {
		AssertTextMatches(
			locator1 = "Drools#DROOLS_CONTENT",
			value1 = ".*${welcomeMessage}.*");

		AssertTextMatches(
			locator1 = "Drools#DROOLS_CONTENT",
			value1 = ".*There are no results\..*");
	}

}